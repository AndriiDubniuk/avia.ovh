APP_ENV=local
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3002

DB_HOST=localhost
DB_PORT=5432
DB_USER=avia
DB_PASSWORD=avia
DB_NAME=avia_agro
DB_SSL=false

TYPEORM_SYNCHRONIZE=true

BILLING_PUBLIC_URL=http://localhost:3002
BILLING_PUBLIC_API_URL=http://localhost:3001
BILLING_PERSONAL_LINK_BASE_URL=http://localhost:3002/pay
BILLING_PERSONAL_LINK_TTL_HOURS=720
BILLING_PRIVATE_MODE=false
BILLING_PLANS_JSON=
BILLING_PORTAL_MAGIC_TTL_MINUTES=15
BILLING_PORTAL_SESSION_TTL_HOURS=24
BILLING_PORTAL_COOKIE_NAME=billing_portal_session
RESEND_API_KEY=
RESEND_FROM_EMAIL=billing@send.avia.ovh
BILLING_NOTIFICATION_TO_EMAIL=owner@avia.ovh

MONOBANK_API_BASE_URL=https://api.monobank.ua
MONOBANK_MODE=mock
MONOBANK_TOKEN=
MONOBANK_WEBHOOK_URL=
MONOBANK_ACQUIRING_TOKEN=
MONOBANK_CHECKOUT_VALIDITY_SECONDS=2592000
TOKEN_ENCRYPTION_KEY=
IDEMPOTENCY_TTL_HOURS=72

# Пошта контактної форми — власний SMTP-сервер, окремо від Resend.
# Без SMTP_HOST заявка лише зберігається в базі.
SMTP_HOST=
SMTP_PORT=587
# true для порту 465 (TLS одразу), false для 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@avia.ovh
CONTACT_NOTIFICATION_TO_EMAIL=sales@avia.ovh

# Дубль заявки в Telegram. Без токена або чату канал просто мовчить.
# TELEGRAM_CHAT_ID: id чату/групи або @назва каналу; кілька — через кому.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
